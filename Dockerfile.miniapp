# syntax=docker/dockerfile:1

ARG NODE_VERSION=24
ARG PNPM_VERSION=12.8.1
ARG CADDY_VERSION=2.11.4

FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS build

ARG PNPM_VERSION

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true

RUN npm install --global "pnpm@${PNPM_VERSION}"

WORKDIR /src

COPY web/miniapp/package.json \
     web/miniapp/pnpm-lock.yaml \
     web/miniapp/pnpm-workspace.yaml \
     ./

RUN --mount=type=cache,id=yalom-bot-miniapp-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY web/miniapp/ ./

RUN pnpm build


FROM caddy:${CADDY_VERSION}-alpine

LABEL org.opencontainers.image.source="https://github.com/slava-nikulin/yalom-bot"

COPY --link web/miniapp/Caddyfile /etc/caddy/Caddyfile
COPY --link --from=build /src/dist/client /srv