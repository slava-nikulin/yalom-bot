{
  "tsrx": {
    "compiler": "@tsrx/solid",
    "platform": "web"
  },

  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],

    "plugins": [{ "name": "@tsrx/typescript-plugin" }]
  }
}
